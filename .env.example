# Preview remains private and noindex until a commercial release is approved.
PROMO_PREMIUM_INDEXABLE=false
# Required before enabling indexation; do not use a staging URL.
PROMO_PREMIUM_SITE_URL=http://localhost:3100
# Exact browser origin allowed to submit a commercial briefing.
PROMO_PREMIUM_SITE_ORIGIN=http://localhost:3100
# Optional. Leave blank to keep the download-only briefing flow.
# This must point to an approved server-side receiver, never directly to a browser CRM key.
BRIEFING_WEBHOOK_URL=
# Explicit opt-in. A URL alone never starts collecting contact data.
BRIEFING_DELIVERY_ENABLED=false
# Set only after the deployment proxy is proven to overwrite this header.
# Allowed: x-vercel-forwarded-for, cf-connecting-ip, x-real-ip.
PROMO_PREMIUM_CLIENT_IP_HEADER=
# Banco dedicado a esta vitrine. Não reutilizar as chaves do sistema comercial.
SUPABASE_PROJECT_REF=whwloseshzraipljisqo
SUPABASE_URL=https://whwloseshzraipljisqo.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://whwloseshzraipljisqo.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_DB_POOLER_HOST=aws-0-us-east-2.pooler.supabase.com
SUPABASE_DB_PASSWORD=

# Catálogo central do Promo Gifts V4: SOMENTE LEITURA via v_products_public.
# Credenciais separadas. Nunca usar secret/service_role para esta origem.
# Não substituir SUPABASE_* acima: eles são o destino exclusivo das gravações.
CATALOG_SOURCE_SUPABASE_URL=https://doufsxqlfjyuvxuezpln.supabase.co
CATALOG_SOURCE_SUPABASE_PUBLISHABLE_KEY=
