{
  "name": "promo-brindes-premium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "check:plan": "node scripts/check-plan.mjs",
    "check:editorial": "node scripts/check-editorial-review.mjs",
    "check:editorial:ready": "node scripts/check-editorial-review.mjs --ready",
    "check:editorial:live": "node --env-file=.env.local scripts/check-editorial-live.mjs",
    "check:public-secrets": "node scripts/check-public-secrets.mjs",
    "check:performance-budget": "node scripts/check-performance-budget.mjs",
    "db:migrate": "node --env-file=.env.local scripts/push-site-migrations.mjs",
    "db:sync-catalog": "node --env-file=.env.local scripts/sync-site-catalog.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/manrope": "^5.2.0",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.8.2",
    "typescript": "^5.9.0"
  }
}
